# Database Configuration
# คัดลอกไฟล์นี้เป็น .env และกรอกข้อมูลการเชื่อมต่อฐานข้อมูล

# PostgreSQL Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ev_station_db
DB_USER=postgres
DB_PASSWORD=your_password_here
# Prisma/PostgreSQL connection string (ปรับ password/host ตามสภาพแวดล้อม)
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/ev_station_db?schema=public"

# Express Server Settings
NODE_ENV=development
PORT=8000

# Security (สำหรับ production)
SECRET_KEY=your-secret-key-here-change-in-production

